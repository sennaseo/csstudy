# 릴리스 서명 정보 — 이 파일을 복사해서 keystore.properties 로 만들고 값을 채운다.
# keystore.properties 는 .gitignore 로 막혀 있다 (절대 커밋되면 안 됨).
#
# storeFile : 프로젝트 루트 기준 상대 경로
# storePassword / keyPassword : keytool 로 키를 만들 때 입력한 비밀번호
#   (따로 지정 안 했으면 둘이 같은 값이다)
# keyAlias : 키를 만들 때 -alias 로 준 이름

storeFile=csstudy-release.keystore
storePassword=여기에_비밀번호
keyAlias=csstudy
keyPassword=여기에_비밀번호
